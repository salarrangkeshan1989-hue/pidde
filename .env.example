# ─────────────────────────────────────────────────────────────────────────
# Pidde — miljovariabler. Kopiera till .env och fyll i. Satt inga hemligheter
# i koden. Pa Railway: satt dessa som service-variabler och montera en volym
# for DATA_DIR sa minnet overlever deploys.
# ─────────────────────────────────────────────────────────────────────────

# Server
PORT=4180
# Var minnet (tradar, minne, kunskap, anvandare) skrivs. Montera en Railway-volym hit.
DATA_DIR=./data
# Lang slumpmassig strang. Signerar inloggnings-cookien. Byt for produktion.
SESSION_SECRET=byt-mig-till-nagot-langt-och-slumpmassigt
# "1" for att alltid markera cookien Secure (bakom https). Railway satter x-forwarded-proto.
FORCE_SECURE=0

# VD:s inloggning (det enda kontot)
PIDDE_USER=vd@senzum.com
PIDDE_PASSWORD=byt-mig-vid-forsta-inloggning

# Claude (motorn just nu). ANTHROPIC_MODEL ar valfri; default claude-sonnet-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (forberett, aktiveras nar nyckeln finns). Vaxlaren i UI:t tands da.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# NEXUS-konsolen — Pidde loggar in har for att lasa Senzums riktiga siffror.
# CONSOLE_USER behover en roll som ser ekonomi/avtal/bemanning (admin/superadmin).
# Lamna tomt sa kor Pidde utan live-data (den sager det rakt ut i stallet for att gissa).
CONSOLE_URL=
CONSOLE_USER=
CONSOLE_PASSWORD=

# Webbsok via Claudes inbyggda web search. PA som standard (satt "0" for att stanga av).
# Kraver att web search ar aktiverat pa ditt Anthropic-konto (Console -> installningar)
# och kostar nagra oren per sok. Ar det inte aktiverat faller Pidde tillbaka utan
# webbsok automatiskt (chatten fortsatter fungera) och sager till.
ENABLE_WEB_SEARCH=1
